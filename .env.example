# === Required ===
# Bot token from @BotFather
BOT_TOKEN=123456789:replace-me

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace-me

# === Optional ===
# Primary model and comma-separated fallbacks (used in order when the primary is busy / rate-limited)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash,gemini-flash-lite-latest

# SQLite database file (relative to the project root)
DB_PATH=data/hamyon.db

# IANA time zone used for dates, daily summaries and the scheduler
TIMEZONE=Asia/Tashkent

# Only this Telegram user id may create the family (empty = the first person who sends /start)
OWNER_TG_ID=

# Max AI requests per user per minute
AI_RATE_PER_MINUTE=12

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
